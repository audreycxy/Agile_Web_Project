# Flask secret key used for session security.
# Change this value before deploying the project.
SECRET_KEY=change-this-before-deploying

# API key for Google Gemini, used by the AI feedback button on the player
# history page. Leave unset to disable the feature (the button will show a
# "not configured" message instead of crashing).
GEMINI_API_KEY=your_gemini_api_key

# Database file path used by the application.
DATABASE=instance/app.db

# Enable automatic database migration when the app starts.
# 1 means enabled, 0 means disabled.
AUTO_MIGRATE=1

# Gmail SMTP settings for real email verification.
# Leave unset to disable outgoing mail (signup will still create accounts
# but the verification email will not be sent).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_project_email@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_DEFAULT_SENDER=your_project_email@gmail.com
