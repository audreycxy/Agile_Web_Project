# Flask secret key used for session security.
# Change this value before deploying the project.
SECRET_KEY=change-this-before-deploying

# API key for Google Gemini, used by the AI feedback button on the player
# history page. Leave unset to disable the feature (the button will show a
# "not configured" message instead of crashing).
GEMINI_API_KEY=your_gemini_api_key

# Database file path used by the application.
DATABASE=instance/app.db

# Enable automatic database migration when the app starts.
# 1 means enabled, 0 means disabled.
AUTO_MIGRATE=1

# Resend HTTPS-API email backend. Signup sends the verification email
# through https://api.resend.com. Get a key from resend.com.
RESEND_API_KEY=your_resend_api_key

# "From" address used on outgoing verification emails. Must be on a domain
# verified in your Resend account (e.g. noreply@yourdomain.xyz). If you do
# not have a verified domain, Resend's free tier only allows sending to
# the email address that registered the Resend account.
MAIL_DEFAULT_SENDER=noreply@your-verified-domain.xyz
